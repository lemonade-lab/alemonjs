{
  "name": "@alemonjs/db",
  "version": "0.0.20",
  "description": "数据库连接",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "lvy build"
  },
  "types": "lib",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "alemonjs": {
    "config": [
      {
        "name": "redis",
        "type": "object",
        "description": "Redis 配置",
        "config": [
          {
            "name": "host",
            "type": "string",
            "required": false,
            "default": "127.0.0.1",
            "description": "Redis 主机地址"
          },
          {
            "name": "port",
            "type": "number",
            "required": false,
            "default": 6379,
            "rules": [
              {
                "pattern": "^[0-9]+$",
                "message": "端口必须为数字"
              }
            ],
            "description": "Redis 端口"
          },
          {
            "name": "password",
            "type": "string",
            "required": false,
            "default": "",
            "description": "Redis 密码"
          },
          {
            "name": "db",
            "type": "number",
            "required": false,
            "default": 0,
            "rules": [
              {
                "pattern": "^[0-9]+$",
                "message": "数据库索引必须为数字"
              }
            ],
            "description": "Redis 数据库索引"
          }
        ]
      },
      {
        "name": "dialect",
        "type": "string",
        "description": "选择SQL数据库",
        "rules": [
          {
            "pattern": "^(pgsql|mysql|sqlite)$",
            "message": "dialect 必须为 pgsql、mysql 或 sqlite"
          }
        ]
      },
      {
        "name": "pgsql",
        "type": "object",
        "description": "PostgreSQL 配置",
        "config": [
          {
            "name": "host",
            "type": "string",
            "required": false,
            "default": "127.0.0.1",
            "description": "数据库主机地址"
          },
          {
            "name": "port",
            "type": "number",
            "required": false,
            "default": 5432,
            "rules": [
              {
                "pattern": "^[0-9]+$",
                "message": "端口必须为数字"
              }
            ],
            "description": "数据库端口"
          },
          {
            "name": "user",
            "type": "string",
            "required": true,
            "description": "数据库用户名"
          },
          {
            "name": "password",
            "type": "string",
            "required": true,
            "description": "数据库密码"
          },
          {
            "name": "database",
            "type": "string",
            "required": true,
            "description": "数据库名称"
          }
        ]
      },
      {
        "name": "mysql",
        "type": "object",
        "description": "MySQL 配置",
        "config": [
          {
            "name": "host",
            "type": "string",
            "required": false,
            "default": "127.0.0.1",
            "description": "数据库主机地址"
          },
          {
            "name": "port",
            "type": "number",
            "required": false,
            "default": 3306,
            "rules": [
              {
                "pattern": "^[0-9]+$",
                "message": "端口必须为数字"
              }
            ],
            "description": "数据库端口"
          },
          {
            "name": "user",
            "type": "string",
            "required": true,
            "description": "数据库用户名"
          },
          {
            "name": "password",
            "type": "string",
            "required": true,
            "description": "数据库密码"
          },
          {
            "name": "database",
            "type": "string",
            "required": true,
            "description": "数据库名称"
          }
        ]
      },
      {
        "name": "sqlite",
        "type": "object",
        "description": "SQLite 配置",
        "config": [
          {
            "name": "storage",
            "type": "string",
            "required": false,
            "default": "./data/alemonapp.db",
            "description": "SQLite 数据库文件存储路径"
          }
        ]
      }
    ],
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages-ex/db/README.md"
    },
    "desktop": {
      "platform": [],
      "logo": "antd.DatabaseOutlined",
      "command": [
        {
          "name": "打开数据库管理",
          "icon": "antd.DatabaseOutlined",
          "command": "open.db"
        }
      ],
      "sidebars": [
        {
          "name": "数据库",
          "icon": "antd.DatabaseOutlined",
          "command": "open.db"
        }
      ]
    }
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "sequelize": "^6.33.0",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "mysql2": "^3.6.2",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.18.1",
    "rollup-plugin-dts": "^6.1.1"
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/alemonjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/alemonjs.git"
  }
}