{
  "name": "@alemonjs/teams",
  "version": "2.1.0",
  "description": "teams social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "@microsoft/teams.apps": "2.1.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/teams/README.md",
      "official": "https://microsoft.github.io/teams-sdk/"
    },
    "config": [
      {
        "name": "client_id",
        "type": "string",
        "required": true,
        "description": "client_id"
      },
      {
        "name": "client_secret",
        "type": "string",
        "required": true,
        "description": "client_secret"
      },
      {
        "name": "tenant_id",
        "type": "string",
        "required": true,
        "description": "tenant_id"
      },
      {
        "name": "port",
        "type": "number",
        "required": false,
        "description": "port"
      }
    ]
  }
}
