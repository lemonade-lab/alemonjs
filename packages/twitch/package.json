{
  "name": "@alemonjs/twitch",
  "version": "2.1.0",
  "description": "twitch social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "@twurple/chat": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/api": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/twitch/README.md",
      "official": "https://twurple.js.org/"
    },
    "config": [
      {
        "name": "client_id",
        "type": "string",
        "required": true,
        "description": "client_id"
      },
      {
        "name": "access_token",
        "type": "string",
        "required": true,
        "description": "access_token"
      },
      {
        "name": "user_id",
        "type": "string",
        "required": true,
        "description": "user_id"
      },
      {
        "name": "username",
        "type": "string",
        "required": false,
        "description": "username"
      },
      {
        "name": "channels",
        "type": "array",
        "required": false,
        "description": "channels"
      },
      {
        "name": "scopes",
        "type": "array",
        "required": false,
        "description": "scopes"
      }
    ]
  }
}
