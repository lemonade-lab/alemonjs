{
  "name": "@alemonjs/dingtalk",
  "version": "2.1.0",
  "description": "dingtalk social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "dingtalk-stream": "2.1.6-beta.1"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/dingtalk/README.md",
      "official": "https://github.com/open-dingtalk/dingtalk-stream-sdk-nodejs"
    },
    "config": [
      {
        "name": "client_id",
        "type": "string",
        "required": true,
        "description": "client_id"
      },
      {
        "name": "client_secret",
        "type": "string",
        "required": true,
        "description": "client_secret"
      },
      {
        "name": "robot_code",
        "type": "string",
        "required": true,
        "description": "robot_code"
      }
    ]
  }
}
