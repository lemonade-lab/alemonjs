{
  "name": "@alemonjs/kook",
  "version": "2.1.13",
  "description": "kook platform connection",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "build": "lvy build"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0-alpha.15"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/kook/README.md",
      "official": "https://developer.kookapp.cn/doc/reference#%E5%B8%B8%E8%A7%84%20http%20%E6%8E%A5%E5%8F%A3%E8%A7%84%E8%8C%83",
      "platform": "https://www.kookapp.cn/app/qrlogin"
    },
    "config": [
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      }
    ],
    "desktop": {
      "platform": [
        {
          "name": "kook",
          "value": "@alemonjs/kook"
        }
      ],
      "logo": "antd.RobotOutlined",
      "command": [
        {
          "name": "kook",
          "icon": "antd.RobotOutlined",
          "command": "open.kook"
        }
      ],
      "sidebars": [
        {
          "name": "kook",
          "icon": "antd.RobotOutlined",
          "command": "open.kook"
        }
      ]
    }
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/alemonjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/alemonjs.git"
  },
  "gitHead": "c6aa5616afe091a37610dad22fbb2d2618d943b8"
}
