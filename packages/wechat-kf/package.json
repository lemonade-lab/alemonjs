{
  "name": "@alemonjs/wechat-kf",
  "version": "2.1.0",
  "description": "wechat-kf social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "wechat-crypto": "0.0.2",
    "fast-xml-parser": "5.11.2"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/wechat-kf/README.md",
      "official": "https://developer.work.weixin.qq.com/document/path/94670"
    },
    "config": [
      {
        "name": "corp_id",
        "type": "string",
        "required": true,
        "description": "corp_id"
      },
      {
        "name": "secret",
        "type": "string",
        "required": true,
        "description": "secret"
      },
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      },
      {
        "name": "encoding_aes_key",
        "type": "string",
        "required": true,
        "description": "encoding_aes_key"
      },
      {
        "name": "open_kfid",
        "type": "string",
        "required": false,
        "description": "open_kfid"
      }
    ]
  }
}
