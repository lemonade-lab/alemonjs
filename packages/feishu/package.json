{
  "name": "@alemonjs/feishu",
  "version": "2.1.0",
  "description": "feishu social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/feishu/README.md",
      "official": "https://github.com/larksuite/node-sdk"
    },
    "config": [
      {
        "name": "app_id",
        "type": "string",
        "required": true,
        "description": "app_id"
      },
      {
        "name": "app_secret",
        "type": "string",
        "required": true,
        "description": "app_secret"
      }
    ]
  }
}
