{
  "name": "@alemonjs/icqq",
  "version": "2.1.0",
  "description": "icqq social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "icqq": "0.6.10"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/icqq/README.md",
      "official": "https://github.com/icqqjs/icqq"
    },
    "config": [
      {
        "name": "uin",
        "type": "string",
        "required": true,
        "description": "uin"
      },
      {
        "name": "data_dir",
        "type": "string",
        "required": false,
        "description": "data_dir"
      },
      {
        "name": "device_platform",
        "type": "number",
        "required": false,
        "description": "device_platform"
      }
    ]
  }
}
