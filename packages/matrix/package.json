{
  "name": "@alemonjs/matrix",
  "version": "2.1.0",
  "description": "matrix social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "matrix-js-sdk": "43.0.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/matrix/README.md",
      "official": "https://github.com/matrix-org/matrix-js-sdk"
    },
    "config": [
      {
        "name": "base_url",
        "type": "string",
        "required": true,
        "description": "base_url"
      },
      {
        "name": "access_token",
        "type": "string",
        "required": true,
        "description": "access_token"
      },
      {
        "name": "user_id",
        "type": "string",
        "required": true,
        "description": "user_id"
      }
    ]
  }
}
