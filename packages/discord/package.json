{
  "name": "@alemonjs/discord",
  "version": "2.1.25",
  "description": "discord platform connection",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "build": "lvy build"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "dependencies": {
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0-alpha.15"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://github.com/lemonade-lab/alemonjs/blob/main/packages/discord/README.md",
      "official": "https://discord.com/developers/docs/intro",
      "platform": "https://discord.com/developers/home"
    },
    "config": [
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      },
      {
        "name": "request_config",
        "type": "object",
        "required": false,
        "default": {},
        "config": [
          {
            "name": "proxy",
            "type": "object",
            "required": false,
            "config": [
              {
                "name": "protocol",
                "type": "string",
                "default": "http",
                "rules": [
                  {
                    "pattern": "^(http|https)$",
                    "message": "协议必须是http或https"
                  }
                ],
                "required": false,
                "description": "协议"
              },
              {
                "name": "host",
                "type": "string",
                "required": false,
                "description": "主机"
              },
              {
                "name": "port",
                "type": "number",
                "rules": [
                  {
                    "pattern": "^[0-9]+$",
                    "message": "端口必须为数字"
                  },
                  {
                    "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}|0)$",
                    "message": "端口范围必须在0~65535之间"
                  }
                ],
                "required": false,
                "description": "端口"
              }
            ],
            "description": "请求代理（推荐使用）配置参考 axios"
          }
        ],
        "description": "请求代理（推荐使用）配置参考 axios"
      },
      {
        "name": "websocket_proxy",
        "type": "string",
        "required": false,
        "default": "",
        "rules": [
          {
            "pattern": "^http://|^https://",
            "message": "ws 代理必须以http://或https://开头"
          },
          {
            "pattern": "^(http|https)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$",
            "message": "ws 代理格式不正确"
          }
        ],
        "description": "ws 代理"
      }
    ],
    "desktop": {
      "platform": [
        {
          "name": "discord"
        }
      ],
      "logo": "antd.DiscordOutlined",
      "command": [
        {
          "name": "discord",
          "icon": "antd.DiscordOutlined",
          "command": "open.discord"
        }
      ],
      "sidebars": [
        {
          "name": "discord",
          "icon": "antd.DiscordOutlined",
          "command": "open.discord"
        }
      ]
    }
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/alemonjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/alemonjs.git"
  },
  "gitHead": "c6aa5616afe091a37610dad22fbb2d2618d943b8"
}
