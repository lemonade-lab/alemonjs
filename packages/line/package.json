{
  "name": "@alemonjs/line",
  "version": "2.1.0",
  "description": "line social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "@line/bot-sdk": "11.3.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/line/README.md",
      "official": "https://github.com/line/line-bot-sdk-nodejs"
    },
    "config": [
      {
        "name": "channel_access_token",
        "type": "string",
        "required": true,
        "description": "channel_access_token"
      },
      {
        "name": "channel_secret",
        "type": "string",
        "required": true,
        "description": "channel_secret"
      }
    ]
  }
}
