{
  "name": "@alemonjs/telegram",
  "version": "2.1.15",
  "description": "TG官方平台",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "@types/node-telegram-bot-api": "^0.64.9",
    "grammy": "^1.30.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0-alpha.15"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/telegram/README.md",
      "official": "https://core.telegram.org/bots/api",
      "platform": "https://t.me/BotFather"
    },
    "config": [
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      },
      {
        "name": "proxy",
        "type": "string",
        "required": false,
        "rules": [
          {
            "pattern": "^http://|^https://",
            "message": "proxy必须以http://或https://开头"
          },
          {
            "pattern": "^(http|https)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$",
            "message": "proxy格式不正确"
          }
        ],
        "description": "proxy"
      }
    ],
    "desktop": {
      "platform": [
        {
          "name": "telegram"
        }
      ],
      "logo": "antd.SendOutlined",
      "command": [
        {
          "name": "telegram",
          "icon": "antd.SendOutlined",
          "command": "open.telegram"
        }
      ],
      "sidebars": [
        {
          "name": "telegram",
          "icon": "antd.SendOutlined",
          "command": "open.telegram"
        }
      ]
    }
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/alemonjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/alemonjs.git"
  },
  "gitHead": "c6aa5616afe091a37610dad22fbb2d2618d943b8"
}
