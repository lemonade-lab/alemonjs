{
  "name": "@alemonjs/heybox",
  "version": "2.1.0",
  "description": "heybox social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "ws": "^8.18.1"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/heybox/README.md",
      "official": "https://heybox.dev/"
    },
    "config": [
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      },
      {
        "name": "bot_id",
        "type": "string",
        "required": false,
        "description": "bot_id"
      }
    ]
  }
}
