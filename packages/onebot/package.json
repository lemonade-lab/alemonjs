{
  "name": "@alemonjs/onebot",
  "version": "2.1.18",
  "description": "oneBot v11",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "lvy build"
  },
  "types": "lib",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "keywords": [
    "alemonjs"
  ],
  "dependencies": {
    "dayjs": "^1.11.13",
    "ws": "^8.18.1"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.14"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://github.com/lemonade-lab/alemonjs/blob/main/packages/onebot/README.md"
    },
    "config": [
      {
        "name": "token",
        "type": "string",
        "required": true,
        "description": "token"
      },
      {
        "name": "url",
        "type": "string",
        "required": true,
        "default": "ws://127.0.0.1:3001",
        "rules": [
          {
            "pattern": "^ws://|^wss://",
            "message": "URL必须以ws://或wss://开头"
          },
          {
            "pattern": "^(ws|wss)://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$",
            "message": "URL格式不正确"
          }
        ],
        "description": "连接地址"
      },
      {
        "name": "reverse_enable",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "是否启用反向连接"
      },
      {
        "name": "reverse_port",
        "type": "number",
        "required": false,
        "default": 3001,
        "rules": [
          {
            "pattern": "^[0-9]+$",
            "message": "端口必须为数字"
          },
          {
            "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}|0)$",
            "message": "端口范围必须在0~65535之间"
          }
        ],
        "description": "反向连接端口"
      }
    ],
    "desktop": {
      "platform": [
        {
          "name": "onebot"
        }
      ],
      "logo": "antd.RobotOutlined",
      "command": [
        {
          "name": "onebot",
          "icon": "antd.RobotOutlined",
          "command": "open.onebot"
        }
      ],
      "sidebars": [
        {
          "name": "onebot",
          "icon": "antd.RobotOutlined",
          "command": "open.onebot"
        }
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/lemonade-lab/alemonjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemonade-lab/alemonjs.git"
  },
  "gitHead": "c6aa5616afe091a37610dad22fbb2d2618d943b8"
}
