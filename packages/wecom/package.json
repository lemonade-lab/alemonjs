{
  "name": "@alemonjs/wecom",
  "version": "2.1.0-rc.1",
  "description": "企业微信",
  "author": "lemonade",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "build": "lvy build",
    "test": "yarn build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.108"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./package": "./package.json"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/wecom/README.md",
      "official": "https://developer.work.weixin.qq.com/document/path/100878",
      "platform": "https://work.weixin.qq.com/"
    },
    "config": [
      {
        "name": "bot_id",
        "type": "string",
        "required": true,
        "description": "智能机器人 Bot ID"
      },
      {
        "name": "secret",
        "type": "string",
        "required": true,
        "description": "智能机器人 Secret"
      }
    ]
  },
  "keywords": [
    "alemonjs",
    "wecom",
    "weixin-work"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
