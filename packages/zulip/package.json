{
  "name": "@alemonjs/zulip",
  "version": "2.1.0",
  "description": "zulip social adapter for AlemonJS",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./driver": {
      "types": "./lib/driver.d.ts",
      "import": "./lib/driver.js"
    },
    "./package": "./package.json"
  },
  "scripts": {
    "build": "lvy build"
  },
  "dependencies": {
    "zulip-js": "2.1.0"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "alemonjs": {
    "config-source": {
      "readme": "https://raw.githubusercontent.com/lemonade-lab/alemonjs/main/packages/zulip/README.md",
      "official": "https://github.com/zulip/zulip-js"
    },
    "config": [
      {
        "name": "realm",
        "type": "string",
        "required": true,
        "description": "realm"
      },
      {
        "name": "email",
        "type": "string",
        "required": true,
        "description": "email"
      },
      {
        "name": "api_key",
        "type": "string",
        "required": true,
        "description": "api_key"
      },
      {
        "name": "default_topic",
        "type": "string",
        "required": false,
        "description": "default_topic"
      }
    ]
  }
}
