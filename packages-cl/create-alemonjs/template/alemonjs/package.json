{
  "name": "alemonjs-app",
  "version": "1.0.0",
  "description": "template app",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx lvy app.ts",
    "view": "npx lvy app.jsxp.ts",
    "build": "npx lvy build",
    "bundle": "npx lvy build",
    "app": "node index.js",
    "review": "npx alemonc start",
    "start": "npx pm2 startOrRestart pm2.config.cjs",
    "stop": "npx pm2 stop pm2.config.cjs",
    "delete": "npx pm2 delete pm2.config.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "devDependencies": {
    "@alemonjs/bubble": "^2.1.15",
    "@alemonjs/db": "^0.0.21",
    "@alemonjs/discord": "^2.1.27",
    "@alemonjs/onebot": "^2.1.23",
    "@alemonjs/qq-bot": "^2.1.37",
    "@types/node": "^26.6.5",
    "alemonjs": "2.1.109",
    "cssnano": "7",
    "jsxp": "1.4.0",
    "lvyjs": "^0.3.1",
    "lvyjs-plugin-postcss": "^0.1.0",
    "lvyjs-plugin-tailwindcss": "^0.1.1",
    "pm2": "^5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}